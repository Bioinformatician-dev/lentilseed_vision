-# Detector classes. These are drawn onto the tray photographs themselves, so
-# they are fixed: a seed's coat colour does not depend on the reader's theme.
-# Warm browns for the coat types, red only for defects, so a glance at an
-# annotated tray separates "different seed" from "problem seed".
-CLASS_COLORS = {
-    "Black seeds": "#2B2B2B",
-    "Defective": "#B4472F",
-    "Dotted seeds": "#8E5B3A",
-    "Marbled seeds": "#B08968",
