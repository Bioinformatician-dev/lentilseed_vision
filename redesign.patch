-"""
-Visual system.
-
-The instrument, not the dashboard. Colours are lifted from the printed workflow
-figure — one hue per panel — so the app and the figure read as the same
-document: blue for acquisition, green for detection, amber for segmentation,
-leaf for phenotypes, violet for physical properties, magenta for reliability,
-teal for validation, orange for outputs.
-
-Type is IBM Plex: Sans for prose, Mono for every measurement. Numbers that will
-be compared down a column are set in tabular figures — a measuring instrument
-should let you read a column without re-aligning your eye at each row.
-
-Two surfaces, not one
----------------------
-Light is a cool paper white; the seeds are warm browns and ambers and the sheet
-should not compete with them. Dark is a deep green-black rather than a tinted
-near-black, so the same eight stage hues stay recognisable against it.
-
-The palette is resolved once per rerun and pushed into the modules that
-captured it, because `ui/panels.py` and `ui/components.py` do
-`from .theme import INK, LINE, MUTED, CARD` at import time and feed those
-values to Plotly, which needs concrete colours rather than CSS variables:
-
-    mode = theme.active_mode()
-    st.markdown(theme.css(mode), unsafe_allow_html=True)
-    theme.bind(mode, ui.panels, ui.components)
-
-`STAGE_COLORS` is mutated in place rather than rebound, so every module holding
-a reference to that dict sees the change without being listed in `bind`.
-"""
-from __future__ import annotations
-
-import streamlit as st
-
-# ---------------------------------------------------------------------------
-# surfaces
-# ---------------------------------------------------------------------------
-
-_SURFACE = {
-    "light": {
-        "paper": "#FAFBFA",
-        "card": "#FFFFFF",
-        "ink": "#12211D",
-        "line": "#E2E6E3",
-        "muted": "#697570",
-        "sunk": "#F2F4F2",     # inset wells: dropzone, code, table stripes
-        "ring": "#3C8B57",     # keyboard focus
-        "swatch_ring": "rgba(18,33,29,.14)",
-        "shadow": "rgba(18,33,29,.06)",
-    },
-    "dark": {
-        "paper": "#101512",
-        "card": "#171D1A",
-        "ink": "#E8EEEA",
-        "line": "#2A332E",
-        "muted": "#8E9C95",
-        "sunk": "#0B0F0D",
-        "ring": "#6FBF8B",
-        "swatch_ring": "rgba(232,238,234,.28)",
-        "shadow": "rgba(0,0,0,.34)",
-    },
-}
-
-# One accent per workflow panel, matching the figure's panel headers.
-#
-# Each hue is used as type — the stage number in a panel head, a live chip, a
-# lit segment of the spine — so both sets are pinned to at least 4.5:1 against
-# their own card. The figure's own amber, leaf and orange sit near 3.2:1 on
-# white, so the light set darkens those three while holding their hue; the dark
-# set lifts all eight. Side by side the eight still read as the same family in
-# the same order, which is the only thing the mapping to the figure needs.
-_STAGES = {
-    "light": {
-        "acquire": "#2E6FA8",
-        "detect": "#388251",
-        "segment": "#9A6A27",
-        "phenotype": "#418144",
-        "physical": "#7659A6",
-        "reliability": "#B24C87",
-        "validation": "#2B7D95",
-        "outputs": "#AC6124",
-    },
-    "dark": {
-        "acquire": "#7FB3E0",
-        "detect": "#77C692",
-        "segment": "#E3AC5E",
-        "phenotype": "#8FCA92",
-        "physical": "#B098DC",
-        "reliability": "#E58FBB",
-        "validation": "#6FBBD2",
-        "outputs": "#F0A662",
-    },
-}
