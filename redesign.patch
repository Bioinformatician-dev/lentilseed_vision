-def class_color(name) -> str:
-    """Case-insensitive lookup, with a neutral for classes we don't publish."""
-    key = str(name).strip().lower()
-    for k, v in CLASS_COLORS.items():
-        if k.lower() == key:
-            return v
-    return DEFAULT_CLASS_COLOR
